# ==============================================================================
# AEGIS Control Tower - Environment Variables Template
# ==============================================================================
# 
# This file contains all environment variables required to run the application.
# Copy this file to .env and fill in your actual values.
# 
# IMPORTANT: 
# - Never commit the .env file to version control
# - Keep sensitive credentials (API keys) secure
# - The .env file is listed in .gitignore for safety
# 
# ==============================================================================

# -------- Application --------
# Base API URL (for development)
VITE_API_BASE_URL=http://localhost:3001

# Vite dev server port (change if 3000 is in use)
VITE_PORT=3000

# -------- IBM watsonx.ai Configuration --------
# These credentials enable the AI Copilot natural-language features.
# Leave blank or undefined to use local fallback (app still works).
# 
# To obtain these credentials:
# 1. Go to https://cloud.ibm.com
# 2. Create or select a Resource Group
# 3. Create a watsonx.ai service instance
# 4. Copy credentials from the service page

# IBM Cloud API Key (obtain from IBM Cloud console)
WATSONX_API_KEY=

# IBM watsonx Project ID
WATSONX_PROJECT_ID=

# IBM watsonx Space ID (optional, if using spaces)
WATSONX_SPACE_ID=

# IBM watsonx Model ID (Granite 3 is recommended)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# -------- IBM watsonx Parameters --------
# Model temperature (0.0 = deterministic, 1.0 = random)
WATSONX_TEMPERATURE=0.7

# Max tokens in response
WATSONX_MAX_TOKENS=512

# Top-p (nucleus sampling)
WATSONX_TOP_P=0.95

# -------- Express Server --------
# Port for the Express.js backend server (watsonx proxy)
EXPRESS_PORT=3001

# Node environment (development, production)
NODE_ENV=development

# -------- Logging --------
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# -------- Feature Flags --------
# Enable/disable AI Copilot
VITE_ENABLE_COPILOT=true

# Enable/disable what-if simulation
VITE_ENABLE_SIMULATION=true

# Enable/disable cold-chain monitoring
VITE_ENABLE_COLDCHAIN=true

# Enable/disable live map
VITE_ENABLE_MAP=true

# Enable/disable analytics export
VITE_ENABLE_ANALYTICS=true

# -------- Map Configuration --------
# Mapbox access token (optional, for advanced map features)
VITE_MAPBOX_ACCESS_TOKEN=

# Map default center (lat, lng)
VITE_MAP_CENTER_LAT=40.7128
VITE_MAP_CENTER_LNG=-74.0060

# Map default zoom level (1-18)
VITE_MAP_DEFAULT_ZOOM=4

# -------- Demo Mode --------
# Use mock data instead of real APIs
VITE_USE_MOCK_DATA=true

# Simulate disruptions on app load
VITE_AUTO_LOAD_DISRUPTIONS=true

# Simulate cold-chain excursions
VITE_AUTO_SIMULATE_EXCURSIONS=true

# ==============================================================================
# Notes:
# ==============================================================================
# 
# 1. Vite Env Vars: Only variables prefixed with VITE_ are exposed to the 
#    frontend. Other variables remain server-side only.
# 
# 2. IBM watsonx Setup:
#    - API Key: https://cloud.ibm.com/iam/apikeys
#    - Project ID: https://cloud.ibm.com/projects
#    - Model options: ibm/granite-3-8b-instruct (recommended)
# 
# 3. Demo Mode: Set VITE_USE_MOCK_DATA=true to run entirely with mock data.
#    No database or external APIs required.
# 
# 4. Cold Restart: After changing .env, restart the dev server
#    (Ctrl+C, then npm run dev)
# 
# ==============================================================================
